generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  MERCHANT
  COLLECTOR
  STATION
  ADMIN
}

enum OrderStatus {
  READY
  ASSIGNED
  COLLECTED
  CANCELLED
}

enum OrderSource {
  MANUAL
}

enum QualityStatus {
  PASS
  FLAG
}

enum DeliveryStatus {
  RECEIVED
  REJECTED
}

model Ward {
  id         String      @id @default(uuid()) @db.Uuid
  name       String
  code       String      @unique
  createdAt  DateTime    @default(now()) @map("created_at")
  merchants  Merchant[]
  collectors Collector[]
  stations   Station[]

  @@map("wards")
}

model User {
  id             String      @id @default(uuid()) @db.Uuid
  zaloId         String      @unique @map("zalo_id")
  phone          String?     @unique
  role           UserRole
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  merchant       Merchant?
  collector      Collector?
  station        Station?

  @@index([role])
  @@map("users")
}

model Merchant {
  id          String                  @id @default(uuid()) @db.Uuid
  userId      String                  @unique @map("user_id") @db.Uuid
  wardId      String                  @map("ward_id") @db.Uuid
  businessName String                 @map("business_name")
  address     String?
  createdAt   DateTime                @default(now()) @map("created_at")
  user        User                    @relation(fields: [userId], references: [id])
  ward        Ward                    @relation(fields: [wardId], references: [id])
  containers  Container[]
  orders      CollectionOrder[]
  transactions CollectionTransaction[]

  @@index([wardId])
  @@map("merchants")
}

model Collector {
  id           String                  @id @default(uuid()) @db.Uuid
  userId       String                  @unique @map("user_id") @db.Uuid
  wardId       String                  @map("ward_id") @db.Uuid
  displayName  String                  @map("display_name")
  isActive     Boolean                 @default(true) @map("is_active")
  lastSeenAt   DateTime?               @map("last_seen_at")
  createdAt    DateTime                @default(now()) @map("created_at")
  user         User                    @relation(fields: [userId], references: [id])
  ward         Ward                    @relation(fields: [wardId], references: [id])
  orders       CollectionOrder[]
  transactions CollectionTransaction[]
  deliveries   StationDelivery[]

  @@index([wardId, isActive])
  @@index([userId, lastSeenAt])
  @@map("collectors")
}

model Station {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @unique @map("user_id") @db.Uuid
  wardId      String            @map("ward_id") @db.Uuid
  name        String
  address     String?
  createdAt   DateTime          @default(now()) @map("created_at")
  user        User              @relation(fields: [userId], references: [id])
  ward        Ward              @relation(fields: [wardId], references: [id])
  deliveries  StationDelivery[]

  @@index([wardId])
  @@map("stations")
}

model Container {
  id          String      @id @default(uuid()) @db.Uuid
  merchantId  String      @map("merchant_id") @db.Uuid
  qrCode      String      @unique @map("qr_code")
  capacityLiters Decimal? @map("capacity_liters") @db.Decimal(10, 2)
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at")
  merchant    Merchant    @relation(fields: [merchantId], references: [id])
  transactions CollectionTransaction[]

  @@index([merchantId, isActive])
  @@map("containers")
}

model CollectionOrder {
  id          String       @id @default(uuid()) @db.Uuid
  merchantId  String       @map("merchant_id") @db.Uuid
  collectorId String?      @map("collector_id") @db.Uuid
  status      OrderStatus   @default(READY)
  source      OrderSource   @default(MANUAL)
  priority    Int           @default(0)
  requestedAt DateTime      @default(now()) @map("requested_at")
  assignedAt  DateTime?     @map("assigned_at")
  completedAt DateTime?     @map("completed_at")
  merchant    Merchant      @relation(fields: [merchantId], references: [id])
  collector   Collector?    @relation(fields: [collectorId], references: [id])
  transactions CollectionTransaction[]

  @@index([status, priority, requestedAt])
  @@index([merchantId, requestedAt])
  @@map("collection_orders")
}

model CollectionTransaction {
  id           String        @id @default(uuid()) @db.Uuid
  clientUuid   String        @unique @map("client_uuid") @db.Uuid
  orderId      String?       @map("order_id") @db.Uuid
  containerId  String        @map("container_id") @db.Uuid
  merchantId   String        @map("merchant_id") @db.Uuid
  collectorId  String        @map("collector_id") @db.Uuid
  actualLiters Decimal       @map("actual_liters") @db.Decimal(10, 2)
  quality      QualityStatus
  geoPoint     Unsupported("geography(Point, 4326)")? @map("geo_point")
  photos       Json          @default("[]")
  collectedAt  DateTime      @default(now()) @map("collected_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  order        CollectionOrder? @relation(fields: [orderId], references: [id])
  container    Container     @relation(fields: [containerId], references: [id])
  merchant     Merchant      @relation(fields: [merchantId], references: [id])
  collector    Collector     @relation(fields: [collectorId], references: [id])

  @@index([collectorId, collectedAt])
  @@index([merchantId, collectedAt])
  @@map("collection_transactions")
}

model StationDelivery {
  id             String         @id @default(uuid()) @db.Uuid
  stationId      String         @map("station_id") @db.Uuid
  collectorId    String         @map("collector_id") @db.Uuid
  expectedLiters Decimal        @map("expected_liters") @db.Decimal(10, 2)
  actualLiters   Decimal        @map("actual_liters") @db.Decimal(10, 2)
  varianceLiters Decimal        @map("variance_liters") @db.Decimal(10, 2)
  status         DeliveryStatus @default(RECEIVED)
  deliveredAt    DateTime       @default(now()) @map("delivered_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  station        Station        @relation(fields: [stationId], references: [id])
  collector      Collector      @relation(fields: [collectorId], references: [id])

  @@index([stationId, deliveredAt])
  @@index([collectorId, deliveredAt])
  @@map("station_deliveries")
}
