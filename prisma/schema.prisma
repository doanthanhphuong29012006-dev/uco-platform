generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MERCHANT
  COLLECTOR
  STATION
  ADMIN
}

enum EntityStatus {
  ACTIVE
  INACTIVE
}

enum MerchantApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ContainerState {
  AT_MERCHANT
  IN_TRANSIT
  AT_STATION
}

enum OrderStatus {
  READY
  ASSIGNED
  COLLECTED
  CANCELLED
}

enum OrderSource {
  MANUAL
  PREDICTED
}

enum Quality {
  PASS
  FLAG
}

enum DeliveryStatus {
  OK
  FLAGGED
}

enum AlertType {
  GEO_MISMATCH
  DELIVERY_VARIANCE
  NO_COLLECTOR_IN_WARD
  WARD_LOCATION_MISMATCH
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
}

model User {
  id        String    @id @default(uuid()) @db.Uuid
  zaloId    String    @unique @map("zalo_id")
  phone     String?   @unique
  name      String?
  role      Role
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  merchant  Merchant?
  collector Collector?
  station   Station?
  refreshTokens RefreshToken[]
  auditLogs AuditLog[]

  @@index([role])
  @@map("users")
}

model Ward {
  id         String      @id @default(uuid()) @db.Uuid
  code       String      @unique
  name       String
  district   String      @default("")
  city       String      @default("Ho Chi Minh City")
  centerLat  Float?      @map("center_lat")
  centerLng  Float?      @map("center_lng")
  status     EntityStatus @default(ACTIVE)
  isActive   Boolean     @default(true) @map("is_active")
  boundary   Unsupported("geometry(MultiPolygon, 4326)")?
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  deletedAt  DateTime?   @map("deleted_at")
  merchants  Merchant[]
  stations   Station[]
  containers Container[]
  collectorWards CollectorWard[]

  @@index([status, isActive])

  @@map("wards")
}

model Merchant {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @unique @map("user_id") @db.Uuid
  wardId       String       @map("ward_id") @db.Uuid
  businessName String       @map("business_name")
  businessType String?      @map("business_type")
  address      String?
  avgDailyLiters Decimal?   @map("avg_daily_liters") @db.Decimal(10, 2)
  lastCollectedAt DateTime? @map("last_collected_at")
  location     Unsupported("geography(Point, 4326)")?
  status       EntityStatus @default(ACTIVE)
  approvalStatus MerchantApprovalStatus @default(PENDING) @map("approval_status")
  rejectionReason String? @map("rejection_reason")
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  deletedAt    DateTime?    @map("deleted_at")
  user         User         @relation(fields: [userId], references: [id])
  ward         Ward         @relation(fields: [wardId], references: [id])
  containers   Container[]
  orders       CollectionOrder[]
  transactions CollectionTransaction[]

  @@index([wardId, isActive])
  @@map("merchants")
}

model Collector {
  id           String                  @id @default(uuid()) @db.Uuid
  userId       String                  @unique @map("user_id") @db.Uuid
  displayName  String                  @map("display_name")
  vehicleType  String?                 @map("vehicle_type")
  maxCapacityLiters Decimal             @default(100) @map("max_capacity_l") @db.Decimal(10, 2)
  status       EntityStatus            @default(ACTIVE)
  isActive     Boolean                 @default(true) @map("is_active")
  lastSeenAt   DateTime?               @map("last_seen_at")
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")
  deletedAt    DateTime?               @map("deleted_at")
  user         User                    @relation(fields: [userId], references: [id])
  orders       CollectionOrder[]
  transactions CollectionTransaction[]
  deliveries   StationDelivery[]
  collectorWards CollectorWard[]

  @@map("collectors")
}

model CollectorWard {
  id          String    @id @default(uuid()) @db.Uuid
  collectorId String    @map("collector_id") @db.Uuid
  wardId      String    @map("ward_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  collector   Collector @relation(fields: [collectorId], references: [id])
  ward        Ward      @relation(fields: [wardId], references: [id])

  @@unique([collectorId, wardId])
  @@index([wardId])
  @@map("collector_wards")
}

model Station {
  id         String            @id @default(uuid()) @db.Uuid
  userId     String            @unique @map("user_id") @db.Uuid
  wardId     String            @map("ward_id") @db.Uuid
  name       String
  address    String?
  location   Unsupported("geography(Point, 4326)")?
  capacityLiters     Decimal          @default(1000) @map("capacity_l") @db.Decimal(10, 2)
  currentVolumeLiters Decimal          @default(0) @map("current_volume_l") @db.Decimal(10, 2)
  status     EntityStatus      @default(ACTIVE)
  isActive   Boolean           @default(true) @map("is_active")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")
  deletedAt  DateTime?         @map("deleted_at")
  user       User              @relation(fields: [userId], references: [id])
  ward       Ward              @relation(fields: [wardId], references: [id])
  deliveries StationDelivery[]

  @@index([wardId, isActive])
  @@map("stations")
}

model Container {
  id             String             @id @default(uuid()) @db.Uuid
  merchantId     String?            @map("merchant_id") @db.Uuid
  wardId         String?            @map("ward_id") @db.Uuid
  qrCode         String             @unique @map("qr_code")
  state          ContainerState     @default(AT_MERCHANT)
  status         EntityStatus       @default(ACTIVE)
  capacityLiters Decimal?           @map("capacity_liters") @db.Decimal(10, 2)
  lastSeenAt     DateTime?          @map("last_seen_at")
  isActive       Boolean            @default(true) @map("is_active")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  deletedAt      DateTime?          @map("deleted_at")
  merchant       Merchant?          @relation(fields: [merchantId], references: [id])
  ward           Ward?              @relation(fields: [wardId], references: [id])
  transactions   CollectionTransaction[]
  orders         CollectionOrder[]

  @@index([merchantId, state])
  @@index([wardId, state])
  @@map("containers")
}

model CollectionOrder {
  id           String                  @id @default(uuid()) @db.Uuid
  merchantId   String                  @map("merchant_id") @db.Uuid
  containerId  String?                 @map("container_id") @db.Uuid
  expectedLiters Decimal?              @map("expected_liters") @db.Decimal(10, 2)
  note         String?
  collectorId  String?                 @map("collector_id") @db.Uuid
  status       OrderStatus             @default(READY)
  source       OrderSource             @default(MANUAL)
  priority     Int                     @default(0)
  requestedAt  DateTime                @default(now()) @map("requested_at")
  assignedAt   DateTime?               @map("assigned_at")
  completedAt  DateTime?               @map("completed_at")
  cancelledAt  DateTime?               @map("cancelled_at")
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")
  deletedAt    DateTime?               @map("deleted_at")
  merchant     Merchant                @relation(fields: [merchantId], references: [id])
  container    Container?              @relation(fields: [containerId], references: [id])
  collector    Collector?              @relation(fields: [collectorId], references: [id])
  transactions CollectionTransaction[]

  @@index([status, priority, requestedAt])
  @@index([merchantId, requestedAt])
  @@map("collection_orders")
}

model CollectionTransaction {
  id           String             @id @default(uuid()) @db.Uuid
  clientUuid   String             @unique @map("client_uuid")
  orderId      String?            @map("order_id") @db.Uuid
  containerId  String             @map("container_id") @db.Uuid
  merchantId   String             @map("merchant_id") @db.Uuid
  collectorId  String             @map("collector_id") @db.Uuid
  actualLiters Decimal            @map("actual_liters") @db.Decimal(10, 2)
  quality      Quality
  geoPoint     Unsupported("geography(Point, 4326)")? @map("geo_point")
  photos       Json               @default("[]")
  collectedAt  DateTime           @default(now()) @map("collected_at")
  createdAt    DateTime           @default(now()) @map("created_at")
  deletedAt    DateTime?          @map("deleted_at")
  syncedAt     DateTime?          @map("synced_at")
  stationDeliveryId String?       @map("station_delivery_id") @db.Uuid
  order        CollectionOrder?   @relation(fields: [orderId], references: [id])
  container    Container          @relation(fields: [containerId], references: [id])
  merchant     Merchant           @relation(fields: [merchantId], references: [id])
  collector    Collector          @relation(fields: [collectorId], references: [id])
  alerts       Alert[]
  stationDelivery StationDelivery? @relation(fields: [stationDeliveryId], references: [id])

  @@index([stationDeliveryId])
  @@map("collection_transactions")
}

model StationDelivery {
  id             String         @id @default(uuid()) @db.Uuid
  clientUuid     String         @unique @map("client_uuid")
  stationId      String         @map("station_id") @db.Uuid
  collectorId    String         @map("collector_id") @db.Uuid
  expectedLiters Decimal        @map("expected_liters") @db.Decimal(10, 2)
  actualLiters   Decimal        @map("actual_liters") @db.Decimal(10, 2)
  varianceLiters Decimal        @map("variance_liters") @db.Decimal(10, 2)
  variancePct    Decimal        @map("variance_pct") @db.Decimal(10, 6)
  status         DeliveryStatus @default(OK)
  note           String?
  photos         Json           @default("[]")
  deliveredAt    DateTime       @default(now()) @map("delivered_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  deletedAt      DateTime?      @map("deleted_at")
  station        Station        @relation(fields: [stationId], references: [id])
  collector      Collector      @relation(fields: [collectorId], references: [id])
  transactions   CollectionTransaction[]
  alerts         Alert[]

  @@index([stationId, deliveredAt])
  @@index([collectorId, deliveredAt])
  @@map("station_deliveries")
}

model Alert {
  id            String               @id @default(uuid()) @db.Uuid
  transactionId String?              @map("transaction_id") @db.Uuid
  stationDeliveryId String?          @map("station_delivery_id") @db.Uuid
  type          AlertType
  severity      AlertSeverity?
  message       String?
  details       Json                 @default("{}")
  createdAt     DateTime             @default(now()) @map("created_at")
  resolvedAt    DateTime?            @map("resolved_at")
  transaction   CollectionTransaction? @relation(fields: [transactionId], references: [id])
  stationDelivery StationDelivery?    @relation(fields: [stationDeliveryId], references: [id])

  @@index([type, createdAt])
  @@map("alerts")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String   @map("actor_user_id") @db.Uuid
  action       String
  entityType   String   @map("entity_type")
  entityId     String   @map("entity_id")
  details      Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")
  actor        User     @relation(fields: [actorUserId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  userId     String    @map("user_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  replacedBy String?   @map("replaced_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt, revokedAt])
  @@map("refresh_tokens")
}
